# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# Email (Gmail app password required)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=FloodGuard Alerts <your-email@gmail.com>

# Site URL (used in email links)
SITE_URL=http://localhost:8000

# Notification rate limiting (seconds between emails to same recipient)
EMAIL_RATE_LIMIT_SECONDS=300
